# ============================================================================
# GTMS Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control
# ============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Maritime Container Inspection"

# Supabase Configuration (to be filled in Task 9/10)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OCR Service Configuration (for Phase 6 - OCR Integration)
# Option 1: Google Cloud Vision API
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_CREDENTIALS=

# Option 2: AWS Textract
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email Service (for Phase 7 - Notifications)
# RESEND_API_KEY=
# EMAIL_FROM=

# SMS Service (for Phase 7 - Notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Maps API (for future use)
# NEXT_PUBLIC_MAPBOX_TOKEN=

# AIS Data Feed (for future use)
# AIS_API_KEY=
# AIS_API_URL=

# Analytics & Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_OCR=false
NEXT_PUBLIC_ENABLE_REALTIME=false
NEXT_PUBLIC_ENABLE_SMS_NOTIFICATIONS=false

# Development Settings
# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
