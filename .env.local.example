# ============================================================================
# GTMS Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control
# ============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Maritime Container Inspection"

# Supabase Configuration (to be filled in Task 9/10)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# OCR Service Configuration (Phase 6 - OCR Integration)
# ============================================================================

# Google Cloud Vision API (Recommended)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Documentation: https://cloud.google.com/vision/docs/setup
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# For LOCAL DEVELOPMENT: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# For PRODUCTION: Base64-encoded service account JSON
# Generate with: cat service-account-key.json | base64 -w 0
# Add this to your hosting platform's environment variables (Vercel, Railway, etc.)
# GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=base64-encoded-json-here

# OR use API key (less secure, not recommended for production)
# GOOGLE_CLOUD_VISION_API_KEY=your-api-key

# Document Storage Configuration
# Option A: Local filesystem (for development/testing)
UPLOAD_DIR=/tmp/gtms-uploads
# Option B: Supabase Storage (recommended for production)
# SUPABASE_STORAGE_BUCKET=bill-of-lading-documents
# Option C: Google Cloud Storage (if using GCP)
# GCS_BUCKET_NAME=gtms-documents

# OCR Processing Configuration
MAX_FILE_SIZE_MB=10
OCR_TIMEOUT_SECONDS=60
MIN_CONFIDENCE_THRESHOLD=60
SUPPORTED_FILE_TYPES=pdf,jpg,jpeg,png,tiff

# Alternative OCR Services (if not using Google Cloud Vision)
# Option 2: AWS Textract
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email Service (for Phase 7 - Notifications)
# RESEND_API_KEY=
# EMAIL_FROM=

# SMS Service (for Phase 7 - Notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ============================================================================
# Phase 7: Container Tracking & Vessel Monitoring
# ============================================================================

# Mapbox Configuration
# Get token from: https://account.mapbox.com/access-tokens/
# Documentation: https://docs.mapbox.com/help/getting-started/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# AIS Stream Configuration
# Get API key from: https://aisstream.io/
# Documentation: https://aisstream.io/documentation
AIS_STREAM_API_KEY=your_ais_stream_api_key_here
AIS_STREAM_WS_URL=wss://stream.aisstream.io/v0/stream

# AIS Webhook Security (generate a random secret)
# Used to authenticate position updates from backend WebSocket client
AIS_WEBHOOK_SECRET=your_random_secret_here

# Vessel Tracking Configuration
VESSEL_POSITION_UPDATE_INTERVAL_MS=30000
VESSEL_HISTORY_RETENTION_DAYS=90
MAX_VESSELS_PER_MAP=500

# Analytics & Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_OCR=false
NEXT_PUBLIC_ENABLE_REALTIME=false
NEXT_PUBLIC_ENABLE_SMS_NOTIFICATIONS=false

# Development Settings
# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
